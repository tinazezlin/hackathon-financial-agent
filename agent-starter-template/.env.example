# Copy to .env (never commit .env). At the hackathon secrets live in ~/.env.secrets instead.
LLM_PROVIDER=groq            # groq | ollama | openai | mock
GROQ_API_KEY=
MODEL_ID=openai/gpt-oss-120b
REASONING_EFFORT=medium      # gpt-oss: low | medium | high
MAX_TOKENS=16000

# Optional tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_DISABLED=1
